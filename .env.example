# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

# Database (MySQL/MariaDB — O2switch)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=bankoplus
DB_PASSWORD=change-me
DB_DATABASE=bankoplus

# JWT — générer des secrets distincts et longs (ex: openssl rand -hex 64)
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_EXPIRES_IN=7d
JWT_MFA_SETUP_SECRET=change-me
JWT_MFA_SETUP_EXPIRES_IN=10m
JWT_MFA_CHALLENGE_SECRET=change-me
JWT_MFA_CHALLENGE_EXPIRES_IN=5m

# Chiffrement du secret TOTP en base (32 octets hex — openssl rand -hex 32)
MFA_SECRET_ENCRYPTION_KEY=change-me

# TOTP
MFA_ISSUER=Banko+

# Antivirus (ClamAV) — obligatoire en production, désactivable en dev local
# si ClamAV n'est pas installé sur la machine.
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
